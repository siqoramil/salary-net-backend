{
  "name": "salarynet-server",
  "version": "1.0.0",
  "description": "SalaryNet backend — Fastify + MongoDB + Redis + Gemini AI",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
