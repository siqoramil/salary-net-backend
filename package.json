    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^9.1.0",
    "@fastify/swagger": "^9.2.0",
    "@google/generative-ai": "^0.24.1",
    "@scalar/fastify-api-reference": "^1.25.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
    "mongoose": "^8.8.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
