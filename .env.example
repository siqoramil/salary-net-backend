# ==== Server ====
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ==== Database ====
MONGODB_URI=mongodb://localhost:27017/salarynet

# ==== Redis ====
REDIS_URL=redis://localhost:6379

# ==== JWT ====
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT value for each. Minimum 32 characters enforced by the server.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ==== Gemini AI ====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ==== SMS — Eskiz.uz ====
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SENDER=4546

# ==== Email (SMTP) ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SalaryNet <no-reply@salarynet.app>

# ==== CORS ====
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://

# ==== Rate limiting ====
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
